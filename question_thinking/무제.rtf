int main() \{\
    int capacity = 17;\
    vector<int> weight = \{4, 7, 9\};\
    vector<int> value = \{7, 13, 16\};\
\
    vector<int> dp(capacity + 1, 0);\
\
    for (int i = 0; i < 3; ++i) \{\
        for (int w = weight[i]; w <= capacity; ++w) \{\
            dp[w] = max(\
                dp[w],\
                dp[w - weight[i]] + value[i]\
            );\
        \}\
    \}\
\
    cout << dp[capacity] << '\\n';\
\}\
